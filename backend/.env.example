APP_ENV=development
# Docker Compose / mongod with replication.replSetName=rs0:
# MONGODB_URL=mongodb://localhost:27017/erp?replicaSet=rs0&directConnection=true
# Windows MongoDB service (standalone, no Docker):
MONGODB_URL=mongodb://127.0.0.1:27017/erp
MONGODB_DB_NAME=erp
REDIS_URL=redis://localhost:6379/0
# No Docker/Redis on Windows? Set true for local API only (in-memory cache; not for production).
REDIS_ALLOW_INMEMORY_FALLBACK=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=erp-system
JWT_AUDIENCE=erp-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_RATE_LIMIT_PER_MINUTE=20
INVITATION_RATE_LIMIT_PER_MINUTE=10
INVITATION_EXPIRE_HOURS=72
TENANT_PROVISIONING_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1
SAAS_BILLING_ENABLED=true
EXPORT_DOWNLOAD_EXPIRE_HOURS=72
EXPORT_STORAGE_PATH=data/exports
LMS_STORAGE_PATH=data/lms
PAYROLL_INTEGRATION_ENABLED=false
DEFAULT_RETENTION_DAYS=90
SUBSCRIPTION_TRIAL_DAYS=14
# Optional secret for POST /api/v1/platform/demo-college/seed (platform admins only)
DEMO_SEED_SECRET=
DEMO_MUTATION_GUARD_ENABLED=true
# Atlas Free (M0) allows 500 collections; this app registers 900+ Beanie models.
# On Free tier set BEANIE_SKIP_INDEXES=true and use Atlas M10+ for production.
# BEANIE_SKIP_INDEXES=false
# Optional: omit college code on student/parent login when each college has its own database (e.g. demo-college)
# LOGIN_DEFAULT_TENANT_CODE=demo-college
